 namespace minitts::server {
 
+// ai-ctl: the key every route but GET /health requires, read once from LLAMA_API_KEY.
+inline const std::string &required_api_key() {
+  static const std::string key = [] {
+    const char *value = std::getenv("LLAMA_API_KEY");
+    return std::string(value != nullptr ? value : "");
+  }();
+  return key;
+}
+
+inline bool request_has_api_key(const HttpRequest &request) {
+  const auto &key = required_api_key();
+  const auto bearer = request.headers.find("authorization");
+  if (bearer != request.headers.end() && bearer->second == "Bearer " + key) {
+    return true;
+  }
+  const auto x_api_key = request.headers.find("x-api-key");
+  return x_api_key != request.headers.end() && x_api_key->second == key;
+}
