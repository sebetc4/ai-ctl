+/// The digest an archive given with `--from` is checked against: the one
+/// given, or the pinned release's. Checksums found beside an archive prove
+/// nothing.
+fn archive_sha256(release: Release, given: Option<Sha256>) -> Result<(Sha256, DigestSource)> {
+    if let Some(given) = given {
+        return Ok((given, DigestSource::Given));
+    }
+    ensure!(
+        release == PINNED.release,
+        "an archive needs --sha256: llama-swap {release} is not the release ai-ctl pins"
+    );
+    Ok((Sha256::parse(PINNED.sha256)?, DigestSource::Pinned))
+}
