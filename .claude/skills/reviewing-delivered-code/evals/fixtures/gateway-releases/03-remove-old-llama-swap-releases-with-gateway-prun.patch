+pub fn render_pruned(pruned: &PrunedReleases, dir: &Path) -> String {
+    if pruned.removed.is_empty() {
+        return format!(
+            "Nothing to remove in {}: {} releases kept\n",
+            dir.display(),
+            pruned.kept
+        );
+    }
+    let removed: Vec<String> = pruned.removed.iter().map(Release::to_string).collect();
+    format!(
+        "Removed {} from {} ({} MB freed); {} kept\n",
+        removed.join(", "),
+        dir.display(),
+        pruned.freed / 1_000_000,
+        pruned.kept
+    )
+}
