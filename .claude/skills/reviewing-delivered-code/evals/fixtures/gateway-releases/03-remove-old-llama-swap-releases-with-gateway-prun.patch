+/// What `gateway prune` did.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct PrunedReleases {
+    pub removed: Vec<Release>,
+    pub kept: usize,
+    /// The bytes the removed releases held.
+    pub freed: u64,
+}
+
+/// Removes every release but the `keep` newest and the current one.
+pub fn prune(store: &dyn GatewayStore, keep: usize) -> Result<PrunedReleases> {
+    let _lock = store.lock()?;
+    let releases = store.releases()?;
+    // On garde toujours la release courante, même avec --keep 0 : `up` en a besoin.
+    let current = store.current()?;
+    let doomed = releases_to_prune(&releases, current, keep);
+    let mut freed = 0;
+    for release in &doomed {
+        freed += store.size(*release)?;
+        store.remove(*release)?;
+    }
+    Ok(PrunedReleases {
+        kept: releases.len() - doomed.len(),
+        removed: doomed,
+        freed,
+    })
+}
