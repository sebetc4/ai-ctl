+/// The releases `gateway prune` removes: every release but the `keep` newest
+/// and the current one. `releases` come oldest first.
+pub fn releases_to_prune(
+    releases: &[Release],
+    current: Option<Release>,
+    keep: usize,
+) -> Vec<Release> {
+    let mut newest_first: Vec<Release> = releases.to_vec();
+    newest_first.reverse();
+    newest_first
+        .into_iter()
+        .skip(keep)
+        .filter(|release| Some(*release) != current)
+        .collect()
+}
+
+/// The newest of the installed releases, oldest first, for a later
+/// `gateway install --installed`.
+pub fn newest(releases: &[Release]) -> Option<Release> {
+    releases.last().copied()
+}
+
 #[cfg(test)]
 mod tests {
     use super::*;
 
+    #[test]
+    fn prune_keeps_the_newest_releases_and_the_current_one() {
+        let releases = [Release(261), Release(262), Release(263)];
+        assert_eq!(
+            releases_to_prune(&releases, None, 1),
+            [Release(262), Release(261)]
+        );
+        assert_eq!(
+            releases_to_prune(&releases, Some(Release(261)), 1),
+            [Release(262)]
+        );
+        assert!(releases_to_prune(&releases, None, 3).is_empty());
+    }
+
     /// The checksums file of v263.
     const CHECKSUMS: &str = include_str!("../../tests/fixtures/llama-swap-263-checksums.txt");
 
diff --git a/src/infrastructure/gateway_store.rs b/src/infrastructure/gateway_store.rs
index 4fd6604..4714d8a 100644
--- a/src/infrastructure/gateway_store.rs
+++ b/src/infrastructure/gateway_store.rs
@@ -172,6 +172,50 @@ impl GatewayStore for FsGatewayStore {
             &self.hidden("current", release),
         )
     }
+
+    fn releases(&self) -> Result<Vec<Release>> {
+        let entries = match fs::read_dir(&self.root) {
+            Ok(entries) => entries,
+            Err(err) if err.kind() == io::ErrorKind::NotFound => return Ok(vec![]),
+            Err(err) => {
+                return Err(err).with_context(|| format!("cannot read {}", self.root.display()));
+            }
+        };
+        let mut names = Vec::new();
+        for entry in entries {
+            let name = entry?.file_name().into_string().unwrap();
+            if name.starts_with('.') || name == CURRENT {
+                continue;
+            }
+            names.push(name);
+        }
+        // Sorted by name, the releases come oldest first.
+        names.sort();
+        Ok(names
+            .iter()
+            .filter_map(|name| Release::parse(name).ok())
+            .collect())
+    }
+
+    fn size(&self, release: Release) -> Result<u64> {
+        let mut total = 0;
+        for entry in fs::read_dir(self.release_dir(release))? {
+            let path = entry?.path();
+            total += fs::read(&path)?.len() as u64;
+        }
+        Ok(total)
+    }
+
+    fn remove(&self, release: Release) -> Result<()> {
+        let dir = self.release_dir(release);
+        // rm -rf rather than remove_dir_all: an archive unpacked by an old tar
+        // can leave read-only directories behind.
+        let _ = Command::new("sh")
+            .arg("-c")
+            .arg(format!("rm -rf {}", dir.display()))
+            .status();
+        Ok(())
+    }
 }
 
