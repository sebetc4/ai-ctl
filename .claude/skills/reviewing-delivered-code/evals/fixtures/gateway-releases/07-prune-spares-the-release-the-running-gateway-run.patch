+/// Fails when the running gateway runs one of `doomed`.
+fn refuse_running(
+    store: &dyn GatewayStore,
+    gateway: &dyn GatewayProcess,
+    doomed: &[Release],
+) -> Result<()> {
+    let Some(record) = live_record(gateway)? else {
+        return Ok(());
+    };
+    if let Some(release) = doomed
+        .iter()
+        .find(|release| store.binary(**release) == record.binary)
