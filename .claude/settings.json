{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.claude/skills/reviewing-delivered-code/scripts/guard.py\""
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^review-",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.claude/skills/reviewing-delivered-code/scripts/guard.py\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^review-",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.claude/skills/reviewing-delivered-code/scripts/guard.py\""
          }
        ]
      }
    ]
  }
}
